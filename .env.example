# v1.2 browser entry URL. Change this to your Anaplan region/home URL.
ANAPLAN_HOME_URL=https://us1a.app.anaplan.com/home
HEADLESS=false
# Time allowed for interactive SSO/login and navigation controls to appear.
LOGIN_TIMEOUT_MS=180000
UI_TIMEOUT_MS=20000
# Allow slow Copy & Archive operations up to 10 minutes before verification fails.
ARCHIVE_VERIFY_TIMEOUT_MS=600000
# Retry only transient browser/navigation failures before Copy & Archive is submitted.
ANAPLAN_SAFE_RETRY_ATTEMPTS=2
ANAPLAN_SAFE_RETRY_DELAY_SECONDS=2
# Minimum free space required for --health-check.
HEALTH_MIN_FREE_MB=500
# BROWSER_PROFILE=/Users/yourname/.anaplan-backup-browser

# Authentication mode for API ID discovery: browser (default) or basic.
# browser = no password stored; workspace/model IDs may be entered in models.yaml.
# basic   = use documented Authentication + Integration APIs to discover/validate IDs.
ANAPLAN_AUTH_MODE=browser
ANAPLAN_AUTH_URL=https://auth.anaplan.com/token/authenticate
ANAPLAN_API_BASE_URL=https://api.anaplan.com/2/0
ANAPLAN_EMAIL=
ANAPLAN_PASSWORD=

# Optional: read the password from macOS Keychain when ANAPLAN_PASSWORD is empty.
# Add it once with:
# security add-generic-password -U -s anaplan-daily-backup -a "your@email.com" -w
# ANAPLAN_KEYCHAIN_SERVICE=anaplan-daily-backup

# Fill and submit a standard Anaplan login form when both credentials are set.
# Set false for manual login. External SSO/MFA remains interactive.
ANAPLAN_BROWSER_AUTO_LOGIN=true

# Retention and rotating log limits.
REPORT_RETENTION_DAYS=90
HEALTH_REPORT_RETENTION_DAYS=90
DIAGNOSTIC_RETENTION_DAYS=14
# Always preserve this many newest backup and health-check reports.
RETENTION_KEEP_LATEST_REPORTS=10
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Optional workspace storage monitoring. This requires ANAPLAN_AUTH_MODE=basic
# and a tenant API response that includes workspace size/capacity fields.
ANAPLAN_STORAGE_MONITOR=false
ANAPLAN_STORAGE_WARNING_PERCENT=85

# Optional notifications. Policy: always, failure, success, or off.
ANAPLAN_NOTIFICATION_POLICY=always
ANAPLAN_NOTIFY_MACOS=false
ANAPLAN_NOTIFY_WINDOWS=false
# ANAPLAN_NOTIFICATION_WEBHOOK=https://example.invalid/your-webhook
ANAPLAN_NOTIFICATION_RETRY_ATTEMPTS=3
ANAPLAN_NOTIFICATION_RETRY_DELAY_SECONDS=2
ANAPLAN_NOTIFICATION_TIMEOUT_SECONDS=15
ANAPLAN_NOTIFICATION_FAILURE_LIMIT=5
